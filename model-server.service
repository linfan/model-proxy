[Unit]
Description=Model Proxy Server (OpenAI / Anthropic)
Documentation=https://github.com/user/openai-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=model-server
Group=model-server
WorkingDirectory=/opt/model-server
ExecStart=/opt/model-server/openai-proxy --config /opt/model-server/config.yaml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/model-server/records
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
